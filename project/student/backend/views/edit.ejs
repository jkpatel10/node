<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit student</title>
</head>
<body>
    <h2>Edit Student</h2>

    <form action="/update?id=<%= student._id %>" method="POST">
        <input type="text" name="name" value="<%= student.name %>" placeholder="Enter your name">
        <input type="number" name="age" value="<%= student.age %>" placeholder="Enter your age">
        <input type="text" name="email" value="<%= student.email %>" placeholder="Enter your email">
        <button type="submit">Update</button>
    </form>

</body>
</html>