<!DOCTYPE html>
<html>
<head>
    <title>View Students</title>
</head>
<body>
    <h2>Student List</h2>

    <% data.map((e, i) => { %>
        <ul>
            <li>Name: <%= e.name %></li>
            <li>Age: <%= e.age %></li>
            <li>Email: <%= e.email %></li>
            <li><a href="/delete?id=<%=e.id%>"><button>delete</button></a></li>
            <li><a href="/edit?id=<%=e.id%>"><button>edit</button></a></li>
        </ul>
    <% }) %>

</body>
</html>