<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Book</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Poppins', sans-serif;
}

body {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;

    background:
        linear-gradient(rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.85)),
        url("https://images.pexels.com/photos/29599224/pexels-photo-29599224.jpeg");

    background-size: cover;
    background-position: center}

.edit-container {
    width: 100%;
    max-width: 500px;
    background: white;
    padding: 35px 40px;
    border-radius: 16px;
    box-shadow: 0 25px 55px rgba(0, 0, 0, 0.25);
}

h1 {
    text-align: center;
    margin-bottom: 30px;
    font-size: 32px;
    font-weight: 700;
    color: #222;
}

form {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

input,
select {
    padding: 14px 16px;
    border-radius: 8px;
    border: 1px solid #ddd;
    font-size: 15px;
}

input:focus,
select:focus {
    outline: none;
    border-color: #ff6b6b;
    box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.2);
}

input[type="submit"] {
    margin-top: 10px;
    background: #ff6b6b;
    color: white;
    border: none;
    font-weight: 600;
    cursor: pointer;
    padding: 14px;
    border-radius: 8px;
    transition: 0.3s;
}

input[type="submit"]:hover {
    background: #ff5252;
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(255, 107, 107, 0.35);
}

.back {
    display: block;
    text-align: center;
    margin-top: 18px;
    text-decoration: none;
    color: #666;
    font-size: 14px;
}

.back:hover {
    color: #ff6b6b;
}
    </style>
</head>

<body>
    <div class="edit-container">
        <h1>Edit Book</h1>
        <form action="/updateData" method="post">
            <input type="text" value="<%=singleData.id%>" hidden name="id">
            <input type="text" value="<%=singleData.name%>" placeholder="Enter the Book name" name="name">
            <input type="text" value="<%=singleData.author%>" placeholder="Enter the Author name" name="author">
            <select name="category">
                <option hidden>Choose the Category</option>
                <option value="novel" <%=singleData.category=='novel' ? 'selected' : "" %>>Novel</option>
                <option value="comics" <%=singleData.category=='comics' ? 'selected' : "" %>>Comics</option>
                <option value="motivation" <%=singleData.category=='motivation' ? 'selected' : "" %>>Motivation</option>
                <option value="history" <%=singleData.category=='history' ? 'selected' : "" %>>History</option>
            </select>
            <input type="submit" value="Update Book">
        </form>
        <a href="/" class="back">← Back to Book List</a>
    </div>
</body>
</html>